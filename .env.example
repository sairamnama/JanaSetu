# ==============================================================================
# GramSeva - Environment Configuration Template
# Copy this file to .env and configure environment-specific values.
# ==============================================================================

# Session & Cryptographic Secret
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Configuration
DATABASE_PATH=gramseva.db
DATABASE_USER=
DATABASE_PASSWORD=

# External Telephony / IVR Service Credentials (Twilio / Exotel)
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_SID=your_telephony_account_sid_here
TELEPHONY_AUTH_TOKEN=your_telephony_auth_token_here
TELEPHONY_CALLER_ID=+910000000000

# Security & Operational Controls (Disabled by default in production)
DEMO_MODE=false
FLASK_DEBUG=false

# Citizen Resolution Escalation Threshold
GRAMSEVA_ESCALATION_THRESHOLD=2
